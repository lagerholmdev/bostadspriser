---
/**
 * "Plats i länet": alla områden som tunna liggande staplar, dyrast överst.
 * Området självt är markerat i accentfärg och namngivet; länets snitt är en lodrät linje.
 * Skärmläsare får en vanlig numrerad lista i stället för bilden.
 */
import { countyStat, rankByPrice, stat } from "../../lib/data";
import { sqm } from "../../lib/format";
import type { Area } from "../../lib/types";
import { areaUrl } from "../../lib/links";

interface Props {
  area: Area;
}
const { area } = Astro.props;
const list = rankByPrice("apartment", "m3");
const price = (a: Area) => stat(a, "apartment", "m3")?.pricePerSqm ?? 0;
const max = Math.max(...list.map(price));
const county = countyStat("apartment", "m3").pricePerSqm ?? 0;
const pct = (v: number) => `${((v / max) * 100).toFixed(2)}%`;
const myIndex = list.findIndex((a) => a.slug === area.slug);
// Namnge första, sista och området självt, så att skalan går att läsa.
const named = new Set([0, list.length - 1, myIndex]);
---

<div class="rank">
  <div class="rank-plot" aria-hidden="true">
    <div class="rank-axis">
      <span />
      <div class="rank-track">
        <span class="rank-county-label" style={`left:${pct(county)}`}>Länets snitt {sqm(county)}</span>
      </div>
    </div>
    {
      list.map((a, i) => (
        <div class:list={["rank-row", { me: a.slug === area.slug, named: named.has(i) }]}>
          <span class="rank-name">{named.has(i) ? a.name : ""}</span>
          <div class="rank-track">
            <div class="rank-bar" style={`width:${pct(price(a))}`} />
            {named.has(i) && (
              <span class="rank-val" style={`left:calc(${pct(price(a))} + 6px)`}>
                {sqm(price(a))}
              </span>
            )}
            <span class="rank-county" style={`left:${pct(county)}`} />
          </div>
        </div>
      ))
    }
  </div>
  <details class="rank-list">
    <summary>Visa alla {list.length} områden som lista</summary>
    <ol>
      {
        list.map((a) => (
          <li class:list={{ me: a.slug === area.slug }}>
            {a.slug === area.slug ? (
              <strong>{a.name}</strong>
            ) : (
              <a href={areaUrl(a.slug)}>{a.name}</a>
            )}
            <span>{sqm(price(a))}</span>
          </li>
        ))
      }
    </ol>
  </details>
</div>

<style>
  .rank {
    display: grid;
    gap: var(--sp-4);
    max-width: 760px;
  }
  .rank-plot {
    --name-w: 11rem;
    display: grid;
  }
  .rank-row,
  .rank-axis {
    display: grid;
    grid-template-columns: var(--name-w) minmax(0, 1fr);
    align-items: center;
    column-gap: var(--sp-3);
  }
  .rank-axis {
    height: 22px;
  }
  .rank-track {
    position: relative;
    height: 100%;
    margin-right: 7.5rem;
  }
  .rank-row {
    height: 9px;
  }
  .rank-row.named {
    height: 26px;
  }
  .rank-bar {
    position: absolute;
    left: 0;
    top: 1px;
    bottom: 1px;
    background: var(--c-line-strong);
    border-radius: 0 2px 2px 0;
  }
  .rank-row.named .rank-bar {
    top: 7px;
    bottom: 7px;
  }
  .rank-row.me .rank-bar {
    top: 5px;
    bottom: 5px;
    background: var(--c-accent);
  }
  .rank-name {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rank-row.me .rank-name {
    font-weight: 700;
    color: var(--c-accent);
  }
  .rank-val {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--fs-xs);
    color: var(--c-ink-2);
    white-space: nowrap;
  }
  .rank-row.me .rank-val {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink);
  }
  .rank-county {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px dashed var(--c-ink-3);
  }
  .rank-county-label {
    position: absolute;
    bottom: 4px;
    transform: translateX(-50%);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    white-space: nowrap;
  }
  .rank-list summary {
    cursor: pointer;
    color: var(--c-accent);
    font-size: var(--fs-sm);
    font-weight: 600;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .rank-list ol {
    margin: var(--sp-2) 0 0;
    padding-left: 2.2em;
    font-size: var(--fs-sm);
    columns: 2 260px;
    column-gap: var(--sp-6);
  }
  .rank-list li {
    break-inside: avoid;
    padding-block: 2px;
  }
  .rank-list li span {
    color: var(--c-ink-3);
    margin-left: var(--sp-2);
  }
  @media (max-width: 560px) {
    .rank-plot {
      --name-w: 7.5rem;
    }
    .rank-name {
      font-size: var(--fs-xs);
    }
    .rank-track {
      margin-right: 6rem;
    }
    .rank-row.me .rank-val {
      font-size: var(--fs-xs);
    }
  }
</style>
