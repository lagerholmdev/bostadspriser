---
/**
 * "Plats i länet": ett utsnitt av prislistan med namn på varje rad. Dyraste och
 * billigaste området, området självt och tre grannar i listan åt varje håll; "…"
 * markerar hoppen. Området är markerat i accentfärg. Länets snitt är en streckad linje.
 * Skärmläsare och den som vill se allt får hela listan i <details> under.
 */
import { countyStat, rankByPrice, rankWindow, stat } from "../../lib/data";
import { number, sqm } from "../../lib/format";
import { areaUrl } from "../../lib/links";
import type { Area } from "../../lib/types";

interface Props {
  area: Area;
}
const { area } = Astro.props;
const list = rankByPrice("apartment", "m3");
const price = (a: Area) => stat(a, "apartment", "m3")?.pricePerSqm ?? 0;
const max = Math.max(...list.map(price));
const county = countyStat("apartment", "m3").pricePerSqm ?? 0;
const pct = (v: number) => `${((v / max) * 100).toFixed(2)}%`;
const myIndex = list.findIndex((a) => a.slug === area.slug);
const shown = rankWindow(list.length, myIndex, 3);
const skipped = (k: number) => {
  // Antal rader som hoppas över vid ett "…".
  const before = shown[k - 1];
  const after = shown[k + 1];
  return before != null && after != null ? after - before - 1 : 0;
};
---

<div class="rank">
  <div class="rank-plot" aria-hidden="true">
    <div class="rank-axis">
      <span></span>
      <div class="rank-track">
        <span class="rank-county-label" style={`left:${pct(county)}`}>
          Länets snitt {number(county)}
        </span>
      </div>
    </div>
    {shown.map((i, k) => {
      if (i == null) {
        return (
          <div class="rank-row gap">
            <span class="rank-name">… {skipped(k)} områden</span>
            <div class="rank-track">
              <span class="rank-county" style={`left:${pct(county)}`} />
            </div>
          </div>
        );
      }
      const a = list[i];
      if (!a) return null;
      const me = a.slug === area.slug;
      return (
        <div class:list={["rank-row", { me }]}>
          <span class="rank-name">
            <span class="rank-no">{i + 1}</span>
            <span class="rank-label">{a.name}</span>
          </span>
          <div class="rank-track">
            <div class="rank-bar" style={`width:${pct(price(a))}`} />
            <span class="rank-county" style={`left:${pct(county)}`} />
            <span class="rank-val" style={`left:calc(${pct(price(a))} + 6px)`}>
              {number(price(a))}
              {me && <span class="rank-unit">&nbsp;kr/kvm</span>}
            </span>
          </div>
        </div>
      );
    })}
  </div>
  <details class="rank-list">
    <summary>Visa alla {list.length} områden som lista</summary>
    <ol>
      {list.map((a) => (
        <li class:list={{ me: a.slug === area.slug }}>
          {a.slug === area.slug ? (
            <strong>{a.name}</strong>
          ) : (
            <a href={areaUrl(a.slug)}>{a.name}</a>
          )}
          <span>{sqm(price(a))}</span>
        </li>
      ))}
    </ol>
  </details>
</div>

<style>
  .rank {
    display: grid;
    gap: var(--sp-4);
    max-width: 760px;
  }
  .rank-plot {
    --name-w: 13rem;
    display: grid;
    padding: var(--sp-3) var(--sp-4) var(--sp-4);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
  }
  .rank-row,
  .rank-axis {
    display: grid;
    grid-template-columns: var(--name-w) minmax(0, 1fr);
    align-items: center;
    column-gap: var(--sp-3);
  }
  .rank-axis {
    height: 24px;
  }
  .rank-track {
    position: relative;
    height: 100%;
    margin-right: 7.5rem;
  }
  .rank-row {
    height: 28px;
  }
  .rank-row.gap {
    height: 24px;
  }
  .rank-bar {
    position: absolute;
    left: 0;
    top: 9px;
    bottom: 9px;
    background: var(--c-line-strong);
    border-radius: 0 2px 2px 0;
  }
  .rank-row.me .rank-bar {
    top: 7px;
    bottom: 7px;
    background: var(--c-accent);
  }
  .rank-name {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    min-width: 0;
    font-size: 13px;
    color: var(--c-ink-2);
  }
  .rank-no {
    flex: none;
    width: 1.6em;
    text-align: right;
    color: var(--c-ink-3);
    font-size: var(--fs-xs);
  }
  .rank-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rank-row.gap .rank-name {
    padding-left: calc(1.6em + var(--sp-2));
    color: var(--c-ink-3);
    font-size: var(--fs-xs);
  }
  .rank-row.me .rank-name {
    font-weight: 700;
    color: var(--c-accent);
  }
  .rank-row.me .rank-no {
    color: var(--c-accent);
  }
  .rank-val {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: var(--fs-xs);
    color: var(--c-ink-2);
    white-space: nowrap;
  }
  .rank-row.me .rank-val {
    font-size: 13px;
    font-weight: 700;
    color: var(--c-ink);
  }
  .rank-county {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px dashed var(--c-ink-3);
  }
  .rank-county-label {
    position: absolute;
    bottom: 4px;
    transform: translateX(-50%);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    white-space: nowrap;
  }
  .rank-list summary {
    cursor: pointer;
    color: var(--c-accent);
    font-size: var(--fs-sm);
    font-weight: 600;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .rank-list ol {
    margin: var(--sp-2) 0 0;
    padding-left: 2.2em;
    font-size: var(--fs-sm);
    columns: 2 260px;
    column-gap: var(--sp-6);
  }
  .rank-list li {
    break-inside: avoid;
    padding-block: 2px;
  }
  .rank-list li span {
    color: var(--c-ink-3);
    margin-left: var(--sp-2);
  }
  @media (max-width: 560px) {
    .rank-plot {
      --name-w: 9.5rem;
      padding: var(--sp-2) var(--sp-3) var(--sp-3);
    }
    .rank-track {
      margin-right: 3.25rem;
    }
    .rank-row.me .rank-val {
      font-size: var(--fs-xs);
    }
    .rank-unit {
      display: none;
    }
  }
  @media (max-width: 360px) {
    .rank-plot {
      --name-w: 8.25rem;
    }
  }
</style>
