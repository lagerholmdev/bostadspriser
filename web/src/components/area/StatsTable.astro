---
/** Senaste 3 och 12 månaderna sida vid sida. Mätvärden som rader, så att tabellen får plats på mobil. */
import { dataset, isThin } from "../../lib/data";
import { money, number, MISSING_TEXT } from "../../lib/format";
import type { MissingReason, Period, StatsByPeriod } from "../../lib/types";
import ChangeValue from "../common/ChangeValue.astro";
import { shareOneDecimal } from "../../lib/context";

interface Props {
  stats: StatsByPeriod;
  caption: string;
  /** Vad som säljs, för radetiketten "Sålda bostadsrätter". */
  noun: string;
  /** Kolumner att visa (standard båda). */
  periods?: Period[];
  /** Andel av beståndet som sålts per period (omsättningen), om den finns. */
  turnover?: Partial<Record<Period, number | null>>;
}
const { stats, caption, noun, periods = ["m3", "m12"], turnover } = Astro.props;
const showTurnover = turnover != null && periods.some((p) => turnover[p] != null);
const head: Record<Period, string> = { m3: "3 mån", m12: "12 mån" };
const miss = (
  p: Period,
  f: "sales" | "pricePerSqm" | "meanPrice" | "change",
): MissingReason | undefined => stats[p].missing?.[f];
const missText = (r: MissingReason | undefined) => (r ? MISSING_TEXT[r] : "saknas");
---

<div class="table-box">
  <table class="data-table stats-table">
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        <td></td>
        {periods.map((p) => (
          <th scope="col">
            <span class="long">Senaste </span>
            {head[p]}
            <span class="per">{dataset.periods[p]}</span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Pris per kvm</th>
        {periods.map((p) => (
          <td class:list={{ "thin-value": isThin(stats[p], p) }}>
            {stats[p].pricePerSqm == null ? (
              <span class="chg-none">{missText(miss(p, "pricePerSqm"))}</span>
            ) : (
              <>
                {number(stats[p].pricePerSqm)} <span class="unit">kr/kvm</span>
              </>
            )}
          </td>
        ))}
      </tr>
      <tr>
        <th scope="row">Medelpris</th>
        {periods.map((p) => (
          <td class:list={{ "thin-value": isThin(stats[p], p) }}>
            {stats[p].meanPrice == null ? (
              <span class="chg-none">{missText(miss(p, "meanPrice"))}</span>
            ) : (
              money(stats[p].meanPrice)
            )}
          </td>
        ))}
      </tr>
      <tr>
        <th scope="row">Sålda {noun}</th>
        {periods.map((p) => (
          <td>
            {stats[p].sales == null ? (
              <span class="chg-none">{missText(miss(p, "sales"))}</span>
            ) : (
              number(stats[p].sales)
            )}
            {isThin(stats[p], p) && stats[p].sales != null && (
              <span class="thin-tag">få affärer</span>
            )}
          </td>
        ))}
      </tr>
      <tr>
        <th scope="row">Förändring</th>
        {periods.map((p) => (
          <td>
            <ChangeValue value={stats[p].change} missing={miss(p, "change")} />
          </td>
        ))}
      </tr>
      {showTurnover && (
        <tr>
          <th scope="row">Andel av {noun} som sålts</th>
          {periods.map((p) => (
            <td>{shareOneDecimal(turnover?.[p])}</td>
          ))}
        </tr>
      )}
    </tbody>
  </table>
</div>

<style>
  .per {
    display: block;
    font-weight: 400;
    color: var(--c-ink-3);
    font-size: var(--fs-xs);
  }
  .stats-table td {
    white-space: nowrap;
  }
  .stats-table .thin-tag {
    margin-left: var(--sp-2);
  }
  @media (max-width: 480px) {
    .long {
      display: none;
    }
    .stats-table th,
    .stats-table td {
      padding: var(--sp-3) var(--sp-2);
      font-size: var(--fs-sm);
    }
    .stats-table tr > :first-child {
      padding-left: var(--sp-3);
    }
    .stats-table tr > :last-child {
      padding-right: var(--sp-3);
    }
    .stats-table td {
      white-space: normal;
    }
    .stats-table tbody th {
      overflow-wrap: break-word;
      hyphens: auto;
    }
    .unit {
      display: block;
      font-size: var(--fs-xs);
      color: var(--c-ink-3);
    }
    .stats-table .thin-tag {
      margin-left: 0;
      display: table;
      margin-left: auto;
      margin-top: 2px;
    }
  }
</style>
