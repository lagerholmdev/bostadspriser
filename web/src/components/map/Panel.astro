---
/**
 * Kartsidans panel. Allt renderas vid bygget med standardläget (pris, bostadsrätter, 3 månader),
 * så sidan går att läsa och söka i innan skriptet laddat. Skriptet ritar sedan om efter adressen.
 */
import { dataset } from "../../lib/data";
import { date } from "../../lib/format";
import { DEFAULT_STATE, defaultPeriod } from "../../lib/url";
import {
  budgetModel,
  changeModel,
  priceModel,
  SORT_LABEL,
  type SortOrder,
} from "../../scripts/map/model";
import { legend } from "../../scripts/map/panel/legend";
import { CITY_HOUSE_NOTE } from "../../scripts/map/panel/text";
import {
  budgetBest,
  budgetHeadline,
  budgetMax,
  budgetResults,
  changeLists,
  changeSummary,
  priceList,
  priceSummary,
} from "../../scripts/map/panel/views";
import BudgetControls from "./BudgetControls.astro";
import SearchBox from "./SearchBox.astro";
import Segmented from "./Segmented.astro";

interface Props {
  base: string;
}
const { base } = Astro.props;
const s = DEFAULT_STATE;
const price = priceModel(s.housing, s.period, "desc");
const budget = budgetModel(s.housing, s.period, s.budget, s.sqm);
// Förändring visas som standard på ett år (lib/url.ts defaultPeriod).
const changePeriod = defaultPeriod("forandring");
const change = changeModel(s.housing, changePeriod);

const tabs = [
  { view: "pris", label: "Pris per kvm" },
  { view: "budget", label: "Var har jag råd?" },
  { view: "forandring", label: "Förändring" },
];
const sortOptions = (Object.keys(SORT_LABEL) as SortOrder[]).map((k) => ({
  value: k,
  label: SORT_LABEL[k],
}));
---

<section class="panel" id="panel" aria-labelledby="panel-title">
  <div class="peek" id="peek" data-slot="peek" hidden></div>
  <div class="panel-scroll" id="panel-scroll">
    <div class="panel-head">
      <h1 id="panel-title">Bostadspriser i Stockholms län</h1>
      <button type="button" class="btn btn-quiet share-btn" id="share">
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
          <path
            d="M10 3v9M6.5 6.5L10 3l3.5 3.5M4 11v4.5c0 .8.7 1.5 1.5 1.5h9c.8 0 1.5-.7 1.5-1.5V11"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        Dela
      </button>
    </div>
    <p class="share-status" id="share-status" role="status" aria-live="polite"></p>
    <div class="share-fallback" id="share-fallback" hidden>
      <label for="share-url">Kopiera länken</label>
      <div class="share-fallback-row">
        <input id="share-url" type="text" readonly />
        <button type="button" class="btn" data-action="close-share">
          Stäng
        </button>
      </div>
    </div>

    <SearchBox />

    <div class="tabs" role="tablist" aria-label="Vad vill du veta?">
      {tabs.map((t) => (
        <button
          type="button"
          role="tab"
          class="tab"
          id={`tab-${t.view}`}
          data-view={t.view}
          aria-controls={`panel-${t.view}`}
          aria-selected={t.view === s.view ? "true" : "false"}
          tabindex={t.view === s.view ? 0 : -1}
        >
          {t.label}
        </button>
      ))}
    </div>

    <div class="filters" id="filters">
      <Segmented
        name="bostad"
        legend="Bostad"
        value="apartment"
        options={[
          { value: "apartment", label: "Bostadsrätter" },
          { value: "house", label: "Villor" },
        ]}
      />
      <Segmented
        name="period"
        legend="Period"
        value="m3"
        options={[
          {
            value: "m3",
            label: "Senaste 3 mån",
            short: "3 mån",
            changeLabel: "På tre månader",
            changeShort: "3 mån",
          },
          {
            value: "m12",
            label: "Senaste 12 mån",
            short: "12 mån",
            changeLabel: "På ett år",
            changeShort: "1 år",
          },
        ]}
      />
      <p class="filter-note" id="house-note" hidden>
        {CITY_HOUSE_NOTE}
      </p>
    </div>

    <div class="views" id="views">
      <section
        class="view"
        id="panel-pris"
        role="tabpanel"
        aria-labelledby="tab-pris"
        data-view-panel="pris"
      >
        <div data-slot="price-summary" set:html={priceSummary(price, s.housing, s.period).value} />
        <Fragment set:html={legend({ view: "pris", housing: s.housing, period: s.period }).value} />
        <div class="list-head">
          <h2 class="list-title">Alla områden</h2>
          <Segmented
            name="sortering"
            legend="Sortera"
            hideLegend
            value="desc"
            options={sortOptions}
            class="seg-small"
          />
        </div>
        <div data-slot="price-list" set:html={priceList(price, s.housing, s.period).value} />
      </section>

      <section
        class="view"
        id="panel-budget"
        role="tabpanel"
        aria-labelledby="tab-budget"
        data-view-panel="budget"
      >
        <BudgetControls />
        <p class="budget-max" data-slot="budget-max" set:html={budgetMax(budget).value} />
        <h2 class="headline" data-slot="budget-headline">
          {budgetHeadline(budget, s.budget, s.sqm)}
        </h2>
        <p class="budget-best" data-slot="budget-best" set:html={budgetBest(budget).value} />
        <p
          class="visually-hidden"
          id="budget-status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        ></p>
        <Fragment
          set:html={legend({ view: "budget", housing: s.housing, period: s.period }).value}
        />
        <div
          data-slot="budget-results"
          set:html={budgetResults(budget, s.budget, s.sqm, s.housing).value}
        />
      </section>

      <section
        class="view"
        id="panel-forandring"
        role="tabpanel"
        aria-labelledby="tab-forandring"
        data-view-panel="forandring"
      >
        <div
          data-slot="change-summary"
          set:html={changeSummary(change, s.housing, changePeriod).value}
        />
        <div
          data-slot="change-legend"
          set:html={legend({ view: "forandring", housing: s.housing, period: changePeriod }).value}
        />
        <div
          data-slot="change-lists"
          set:html={changeLists(change, s.housing, changePeriod).value}
        />
      </section>
      <a class="to-filters" href="#filters" data-action="to-filters">
        Till filtren <span aria-hidden="true">↑</span>
      </a>
    </div>

    <section
      class="detail-wrap"
      id="detail"
      data-slot="detail"
      aria-label="Valt område"
      hidden
    ></section>

    <p class="panel-foot">
      Källa:{" "}
      <a href={dataset.source.url} rel="noopener">
        {dataset.source.name}
      </a>
      , uppdaterad {date(dataset.updated)}.<a href={`${base}om/`}>Om datan</a>
    </p>
  </div>

  <div class="tray" id="tray" hidden>
    <p class="tray-note" id="tray-note" hidden></p>
    <div id="tray-body"></div>
  </div>
  <p class="visually-hidden" id="tray-status" role="status" aria-live="polite"></p>
</section>
