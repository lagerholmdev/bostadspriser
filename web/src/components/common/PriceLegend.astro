---
/** Prisskalans färger med klassgränser i text. Samma gränser varje månad. */
import { priceLegend } from "../../lib/scales";

interface Props {
  title?: string;
}
const { title = "Pris per kvm, kr" } = Astro.props;
const items = priceLegend();
---

<div class="legend">
  <p class="legend-title">{title}</p>
  <ul>
    {
      items.map((it) => (
        <li>
          <span class="swatch" style={`background:${it.color}`} />
          {it.label}
        </li>
      ))
    }
  </ul>
</div>

<style>
  .legend {
    font-size: var(--fs-xs);
    color: var(--c-ink-2);
  }
  .legend-title {
    font-weight: 600;
    margin-bottom: var(--sp-1);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
</style>
