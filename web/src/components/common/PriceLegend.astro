---
/**
 * Prisskalan som en sammanhängande färgstapel med klassgränserna under, i tusen kr.
 * Samma utseende som förklaringen på kartsidan. Skärmläsare får klasserna i klartext.
 */
import { PRICE_BREAKS, PRICE_COLORS, priceLegend } from "../../lib/scales";

interface Props {
  title?: string;
}
const { title = "Pris per kvm, tusen kr" } = Astro.props;
const n = PRICE_COLORS.length;
---

<div class="ramp-legend">
  <p class="rl-title">{title}</p>
  <div class="rl-scale" aria-hidden="true">
    {PRICE_COLORS.map((c) => <span style={`background:${c}`} />)}
  </div>
  <div class="rl-ticks" aria-hidden="true">
    {PRICE_BREAKS.map((b, i) => <span style={`left:${(((i + 1) / n) * 100).toFixed(3)}%`}>{b / 1000}</span>)}
  </div>
  <ul class="visually-hidden">
    {priceLegend().map((it) => <li>{it.label} kr per kvm</li>)}
  </ul>
</div>

<style>
  .ramp-legend {
    font-size: var(--fs-xs);
    color: var(--c-ink-2);
    line-height: 1.3;
    width: 100%;
    max-width: 18rem;
  }
  .rl-title {
    font-weight: 600;
    color: var(--c-ink);
    margin-bottom: 6px;
  }
  .rl-scale {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    height: 10px;
    border-radius: 3px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgb(26 31 28 / 0.08);
  }
  .rl-ticks {
    position: relative;
    height: 1.3em;
    margin-top: 3px;
  }
  .rl-ticks > span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
  }
</style>
