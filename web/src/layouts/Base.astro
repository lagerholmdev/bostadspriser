---
/**
 * Gemensam ram för alla sidor: metataggar, sidhuvud och sidfot.
 * `fullBleed` används av kartsidan, som själv styr sin layout under sidhuvudet.
 */
import "../styles/base.css";
import { dataset } from "../lib/data";
import { date } from "../lib/format";
import { aboutUrl, areasUrl, base as siteBase, compareUrl } from "../lib/links";
import Logo from "../components/common/Logo.astro";

interface Props {
  title: string;
  description: string;
  /** Sökväg till delningsbild relativt sajtens bas, t.ex. "og/sodermalm.png". */
  image?: string;
  /** Beskrivning av delningsbilden för skärmläsare. */
  imageAlt?: string;
  fullBleed?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "og/start.png",
  imageAlt = "Karta över bostadspriser i Stockholms län",
  fullBleed = false,
  noindex = false,
} = Astro.props;
const base = siteBase();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(`${base}${image}`, Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  { href: base, label: "Karta", current: path === base, home: true },
  { href: areasUrl(), label: "Områden", current: path.startsWith(areasUrl()), home: false },
  { href: compareUrl(), label: "Jämför", current: path.startsWith(compareUrl()), home: false },
  { href: aboutUrl(), label: "Om datan", current: path.startsWith(aboutUrl()), home: false },
];
const goatcounter = import.meta.env.PUBLIC_GOATCOUNTER as string | undefined;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stockholms prislandskap" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f3f4f1" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    {
      goatcounter && (
        <script
          is:inline
          async
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
          src="https://gc.zgo.at/count.js"
        />
      )
    }
    <slot name="head" />
  </head>
  <body class:list={{ "full-bleed": fullBleed }}>
    <a class="skip" href="#main">Hoppa till innehållet</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href={base} aria-label="Stockholms prislandskap, till kartan">
          <Logo class="brand-mark" />
          <span class="brand-name"><span>Stockholms</span> <span>prislandskap</span></span>
        </a>
        <nav aria-label="Huvudmeny">
          <ul>
            {
              nav.map((n) => (
                <li class:list={{ "nav-home": n.home }}>
                  <a href={n.href} aria-current={n.current ? "page" : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    {
      !fullBleed && (
        <footer class="site-footer">
          <div class="wrap">
            <p>
              Siffrorna kommer från{" "}
              <a href={dataset.source.url} rel="noopener">
                {dataset.source.name}
              </a>{" "}
              och uppdaterades {date(dataset.updated)}. De är snittpriser för sålda bostäder; en enskild
              bostad kan kosta mer eller mindre.
            </p>
            <p>
              <a href={aboutUrl()}>Om datan och metoden</a>
            </p>
          </div>
        </footer>
      )
    }
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--sp-3);
    top: -100px;
    z-index: 100;
    background: var(--c-surface);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }
  .skip:focus {
    top: var(--sp-3);
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-line);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .site-header-inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
    max-width: none;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--c-ink);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--fs-md);
    letter-spacing: -0.01em;
  }
  .brand :global(.brand-mark) {
    width: 28px;
    height: 28px;
    flex: none;
  }
  nav ul {
    display: flex;
    gap: var(--sp-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--sp-3);
    border-radius: var(--radius-sm);
    color: var(--c-ink-2);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--c-ink);
    background: var(--c-page);
  }
  nav a[aria-current="page"] {
    color: var(--c-accent);
    background: var(--c-accent-soft);
  }
  .site-footer {
    border-top: 1px solid var(--c-line);
    background: var(--c-surface);
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    margin-top: var(--sp-8);
  }
  .site-footer .wrap {
    padding-block: var(--sp-5) var(--sp-6);
    display: grid;
    gap: var(--sp-2);
    max-width: 72ch;
    margin-left: max(0px, calc((100% - var(--content-w)) / 2));
  }
  @media (max-width: 640px) {
    .brand {
      min-height: var(--tap);
    }
    .brand-name {
      display: flex;
      flex-direction: column;
      font-size: 13px;
      line-height: 1.05;
    }
    nav ul {
      gap: 0;
    }
    nav a {
      padding: 0 var(--sp-2);
      font-size: 13px;
    }
  }
  /* På smala skärmar leder märket till kartan, så "Karta" behövs inte i menyn. */
  @media (max-width: 480px) {
    .nav-home {
      display: none;
    }
  }
  @media (max-width: 359px) {
    .brand-name {
      display: none;
    }
  }
</style>
