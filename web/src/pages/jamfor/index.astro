---
/**
 * Jämför upp till tre områden. Tabellen ritas i webbläsaren från det inbyggda
 * datasetet (scripts/compare.ts); utan JavaScript visas valen och tomt läge.
 * Adress: ?omraden=a,b,c. Äldre ?a=&b=&c= och ?jamfor=a,b fungerar också.
 */
import Base from "../../layouts/Base.astro";
import CopyLink from "../../components/common/CopyLink.astro";
import { areasUrl, compareUrl } from "../../lib/links";
import "../../components/common/common.css";
import { areas, areasFor, bySlug, dataset } from "../../lib/data";
import { joinNames } from "../../lib/text";

const collator = new Intl.Collator("sv");
const sorted = [...areas].sort((a, b) => collator.compare(a.name, b.name));
const optgroups = [
  { label: "Stockholms stad", list: sorted.filter((a) => a.kind === "district") },
  { label: "Kommuner i länet", list: sorted.filter((a) => a.kind === "municipality") },
];
const SUGGESTIONS: string[][] = [
  ["sodermalm", "kungsholmen", "vasastan-norrmalm"],
  ["nacka", "solna", "sundbyberg"],
  ["hagersten-liljeholmen", "enskede-skarpnack", "bromma-vasterled"],
];
const suggestions = SUGGESTIONS.map((s) => s.filter((x) => bySlug.has(x))).filter((s) => s.length >= 2);
const names = (s: string[]) => joinNames(areasFor(s).map((a) => a.name));
const slots = [1, 2, 3];
---

<Base
  title="Jämför bostadspriser mellan områden | Stockholms prislandskap"
  description={`Jämför pris per kvm, prisförändring och sålda bostäder för upp till tre områden i Stockholms län sida vid sida. Siffror från ${dataset.source.name}, ${dataset.periods.m3}.`}
  image="og/start.png"
>
  <div class="wrap compare-page">
    <header class="intro">
      <h1>Jämför områden</h1>
      <p class="lead">Välj upp till tre områden och se priserna sida vid sida. Länken går att dela.</p>
    </header>

    <form class="picker" id="compare-form" action="" method="get" aria-label="Välj områden att jämföra">
      {
        slots.map((n) => (
          <div class="slot" data-slot={n - 1}>
            <label for={`slot-${n}`}>Område {n}</label>
            <div class="slot-row">
              <select id={`slot-${n}`} name={["a", "b", "c"][n - 1]}>
                <option value="">Välj område</option>
                {optgroups.map((g) => (
                  <optgroup label={g.label}>
                    {g.list.map((a) => (
                      <option value={a.slug}>{a.name}</option>
                    ))}
                  </optgroup>
                ))}
              </select>
              <button type="button" class="remove" data-remove={n - 1} aria-label="Ta bort" hidden>
                <span aria-hidden="true">×</span>
              </button>
            </div>
          </div>
        ))
      }
      <noscript>
        <button class="btn btn-primary" type="submit">Jämför</button>
      </noscript>
    </form>

    <section class="result" id="compare-result" aria-labelledby="result-title" hidden>
      <div class="result-head">
        <h2 id="result-title">Jämförelse</h2>
        <CopyLink class="result-copy" />
      </div>
      <div id="compare-table"></div>
      <p class="fineprint" id="compare-notes"></p>
    </section>

    <section class="empty" id="compare-empty" aria-labelledby="empty-title">
      <h2 id="empty-title">Välj minst två områden</h2>
      <p>
        Välj områden i rutorna ovan, eller börja med en av jämförelserna här. Du ser pris per kvm, hur priserna har
        rört sig och vad 5 mkr räcker till.
      </p>
      <ul class="suggest" id="compare-suggest">
        {
          suggestions.map((s) => (
            <li>
              <a class="btn" href={compareUrl(s)} data-suggest={s.join(",")}>
                {names(s)}
              </a>
            </li>
          ))
        }
      </ul>
      <noscript>
        <p class="fineprint">
          Jämförelsen behöver JavaScript. Utan det kan du läsa om varje område på <a href={areasUrl()}
            >områdessidorna</a
          >.
        </p>
      </noscript>
    </section>

    <p class="source fineprint">
      Källa: <a href={dataset.source.url} rel="noopener">{dataset.source.name}</a>, {dataset.periods.m3} (3 mån) och
      {" "}{dataset.periods.m12} (12 mån).
    </p>
  </div>
</Base>

<script>
  import "../../scripts/compare";
</script>

<style>
  .compare-page {
    padding-top: var(--sp-7);
  }
  .intro {
    display: grid;
    gap: var(--sp-3);
    max-width: 68ch;
  }
  .intro h1 {
    font-size: var(--fs-2xl);
    font-weight: 700;
  }
  .lead {
    font-size: var(--fs-lg);
    color: var(--c-ink-2);
  }
  .picker {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-4);
    margin-top: var(--sp-6);
    align-items: end;
  }
  .slot {
    display: grid;
    gap: var(--sp-1);
  }
  .slot label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink-2);
  }
  .slot-row {
    display: flex;
    gap: var(--sp-2);
  }
  .slot-row {
    position: relative;
  }
  select {
    flex: 1;
    min-width: 0;
    font: inherit;
    min-height: max(44px, var(--tap));
    padding: 0 2.25rem 0 var(--sp-3);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    background-color: var(--c-surface);
    color: var(--c-ink);
    appearance: none;
    /* Pil ritad med två gradienter, så att färgen följer texten. */
    background-image:
      linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      calc(100% - 18px) 50%,
      calc(100% - 13px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    cursor: pointer;
  }
  select:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 0;
    border-color: var(--c-accent);
  }
  select.empty-select {
    color: var(--c-ink-3);
  }
  /* × för att ta bort ett val, inne i väljarens rad. */
  .remove {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 44px;
    min-height: 44px;
    padding: 0;
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    background: var(--c-surface);
    color: var(--c-ink-2);
    cursor: pointer;
  }
  .remove:hover {
    color: var(--c-ink);
    border-color: var(--c-ink-3);
    background: var(--c-page);
  }
  .result {
    margin-top: var(--sp-6);
    display: grid;
    gap: var(--sp-3);
  }
  .result-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
  }
  .result-head h2 {
    font-size: var(--fs-lg);
    font-weight: 600;
    min-width: 0;
    hyphens: auto;
  }
  .result-head :global(.result-copy) {
    flex: none;
    margin-left: auto;
    justify-content: flex-end;
    max-width: 60%;
  }
  .empty {
    margin-top: var(--sp-6);
    padding: var(--sp-6);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    display: grid;
    gap: var(--sp-3);
  }
  .empty[hidden],
  .result[hidden] {
    display: none;
  }
  .empty h2 {
    font-size: var(--fs-xl);
    font-weight: 600;
  }
  .empty > p {
    color: var(--c-ink-2);
    max-width: 60ch;
  }
  .suggest {
    list-style: none;
    margin: var(--sp-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .suggest .btn {
    min-height: max(44px, var(--tap));
    text-align: left;
    padding-block: var(--sp-2);
    line-height: 1.35;
  }
  .source {
    margin-top: var(--sp-6);
  }

  /* Tabellen ritas av skriptet. */
  #compare-table :global(table) {
    table-layout: fixed;
  }
  #compare-table :global(thead th) {
    vertical-align: bottom;
    text-align: right;
  }
  #compare-table :global(.col-head a) {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: none;
  }
  #compare-table :global(.col-head a:hover) {
    color: var(--c-accent);
    text-decoration: underline;
  }
  #compare-table :global(.col-kind) {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--c-ink-3);
  }
  #compare-table :global(.label-col) {
    width: 30%;
  }
  #compare-table :global(tbody th) {
    color: var(--c-ink-2);
    font-weight: 500;
  }
  #compare-table :global(.cell-sub) {
    display: block;
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
  }
  #compare-table :global(.val-main) {
    font-weight: 600;
  }
  #compare-table :global(.swatch) {
    margin-right: 6px;
    vertical-align: -1px;
  }
  #compare-table :global(.ref) {
    color: var(--c-ink-3);
  }
  #compare-table :global(.col-head a) {
    hyphens: auto;
    overflow-wrap: normal;
  }
  #compare-table :global(.thin-tag) {
    margin-left: var(--sp-2);
  }

  @media (max-width: 720px) {
    .compare-page {
      padding-top: var(--sp-5);
    }
    .lead {
      font-size: var(--fs-md);
    }
    .picker {
      grid-template-columns: 1fr;
      gap: var(--sp-3);
    }
    .empty {
      padding: var(--sp-5) var(--sp-4);
    }
    .empty h2 {
      font-size: var(--fs-lg);
    }
    .suggest {
      flex-direction: column;
    }
    .suggest .btn {
      width: 100%;
    }
    /*
     * Mobil: varje mätvärde blir ett eget block med etiketten överst och områdena
     * i kolumner under, så att inget behöver skrollas i sidled.
     */
    #compare-table :global(table),
    #compare-table :global(thead),
    #compare-table :global(tbody) {
      display: block;
    }
    #compare-table :global(tr) {
      display: grid;
      grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
      border-bottom: 1px solid var(--c-line);
    }
    #compare-table :global(tbody tr:last-child) {
      border-bottom: 0;
    }
    #compare-table :global(th),
    #compare-table :global(td) {
      border-bottom: 0;
      padding: var(--sp-2) var(--sp-2);
      text-align: left;
      font-size: var(--fs-sm);
      overflow-wrap: break-word;
      hyphens: auto;
      min-width: 0;
    }
    #compare-table :global(td:nth-child(n + 2)),
    #compare-table :global(th:nth-child(n + 2)) {
      padding-right: var(--sp-1);
    }
    #compare-table :global(tr > :first-child) {
      padding-left: var(--sp-3);
    }
    #compare-table :global(.unit) {
      display: block;
      font-size: var(--fs-xs);
      font-weight: 400;
      color: var(--c-ink-3);
    }
    #compare-table :global(thead .label-col) {
      display: none;
    }
    #compare-table :global(thead tr) {
      position: sticky;
      top: var(--header-h);
      background: var(--c-surface);
      z-index: 2;
      border-bottom: 1px solid var(--c-line-strong);
    }
    #compare-table :global(thead th) {
      text-align: left;
      padding-block: var(--sp-3);
    }
    #compare-table :global(.col-head a) {
      font-size: var(--fs-sm);
      overflow-wrap: break-word;
    }
    #compare-table :global(tbody th) {
      grid-column: 1 / -1;
      padding-top: var(--sp-3);
      padding-bottom: 0;
      font-size: var(--fs-xs);
      font-weight: 600;
      color: var(--c-ink-3);
    }
    #compare-table :global(tbody td) {
      padding-top: var(--sp-1);
      padding-bottom: var(--sp-3);
    }
    #compare-table :global(.thin-tag) {
      margin-left: 0;
      display: table;
      margin-top: 2px;
    }
    #compare-table :global(.chg-word) {
      display: block;
      margin-left: 0;
    }
  }
  @media (max-width: 360px) {
    #compare-table :global(.col-head a) {
      font-size: 13px;
      letter-spacing: -0.01em;
    }
    #compare-table :global(th),
    #compare-table :global(td) {
      padding-left: var(--sp-1);
    }
    #compare-table :global(tr > :first-child) {
      padding-left: var(--sp-2);
    }
  }
</style>
