---
/**
 * Områdessida: en statisk sida per område. Det är hit folk kommer när de söker
 * "bostadspriser <område>", så allt viktigt ska stå i klartext högst upp.
 */
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import Breadcrumb from "../../../components/common/Breadcrumb.astro";
import CopyLink from "../../../components/common/CopyLink.astro";
import Minimap from "../../../components/area/Minimap.astro";
import StatsTable from "../../../components/area/StatsTable.astro";
import RankChart from "../../../components/area/RankChart.astro";
import BudgetFit from "../../../components/area/BudgetFit.astro";
import SimilarAreas from "../../../components/area/SimilarAreas.astro";
import AreaContext from "../../../components/area/AreaContext.astro";
import { areaTurnover, contextValues, countyTurnover, shareOneDecimal } from "../../../lib/context";
import { aboutUrl, areasUrl, areaUrl, compareUrl, mapUrl } from "../../../lib/links";
import "../../../components/common/common.css";
import {
  areas,
  countyRatio,
  countyStat,
  dataset,
  isThin,
  KIND_LABEL,
  placeInCounty,
  shownStat,
  similarNeighbours,
} from "../../../lib/data";
import {
  change,
  date,
  inArea,
  money,
  number,
  relative,
  sqm,
  MISSING_TEXT,
} from "../../../lib/format";
import { changeSentence, joinNames, rankPhrase } from "../../../lib/text";
import type { Area, MissingReason, Stat } from "../../../lib/types";

export const getStaticPaths = (() =>
  areas.map((area) => ({ params: { slug: area.slug }, props: { area } }))) satisfies GetStaticPaths;

interface Props {
  area: Area;
}
const { area } = Astro.props;

const where = inArea(area.slug, area.name); // "på Södermalm"
const ap3: Stat | null = area.apartment?.m3 ?? null;
const ap12: Stat | null = area.apartment?.m12 ?? null;
const price = ap3?.pricePerSqm ?? null;
const county = countyStat("apartment", "m3");
const ratio = countyRatio(price);
const thin = isThin(ap3, "m3");
const rank = placeInCounty(area, "apartment", "m3");
const similar = similarNeighbours(area, 3);
const isDistrict = area.kind === "district";
const updated = date(dataset.updated);
const hasContext = contextValues(area).length > 0;
const turnover = { m3: areaTurnover(area, "m3"), m12: areaTurnover(area, "m12") };
const countyTurnover12 = countyTurnover("m12");

const reasons = new Set<MissingReason>();
for (const s of [ap3, ap12, area.house?.m3, area.house?.m12]) {
  for (const r of Object.values(s?.missing ?? {})) if (r) reasons.add(r);
}
const missingNote = (r: MissingReason | undefined) => (r ? MISSING_TEXT[r] : "saknas");

// "65 % över" eller "i nivå med", följt av "länets snitt".
const relSentence = ratio == null ? null : relative(ratio);
const trend = changeSentence(ap12?.change, ap3?.change);
// Hårt mellanslag efter ordningstalet, så att "3:e dyrast" inte bryts isär.
const rankText = rank
  ? rankPhrase(rank.rank, rank.total).replace(/^(\d+:[ae]) /, "$1\u00a0")
  : null;
const imageAlt = `Karta över ${area.name} med pris per kvm i grannområdena`;

// Titel och beskrivning med riktiga siffror, för sökresultatet.
const title = `Bostadspriser ${where} – ${price != null ? sqm(price) : "pris per kvm"} | Stockholms prislandskap`;
// Förändringen på ett år, som sajten visar som standard (tre månader om årssiffran saknas).
const changeText =
  ap12?.change != null
    ? `${change(ap12.change)} på ett år`
    : ap3?.change != null
      ? `${change(ap3.change)} på tre månader`
      : null;
const description =
  price != null && ap3
    ? `Bostadsrätter ${where} kostar i snitt ${sqm(price)} (${dataset.periods.m3}), ${relSentence} länets snitt. ` +
      `${number(ap3.sales)} sålda${changeText ? `, ${changeText}` : ""}. Grannområden, karta och vad 5 mkr räcker till.`
    : `Bostadspriser ${where}: pris per kvm, sålda bostäder och prisförändring från Svensk Mäklarstatistik.`;

const neighboursForCompare = similar.slice(0, 2).map((a) => a.slug);
// Villapriser med under MIN_HOUSE_SALES affärer visas inte (samma regel som kartan).
const house3 = shownStat(area, "house", "m3");
const house12 = shownStat(area, "house", "m12");
const houseStats = house3 && house12 ? { m3: house3, m12: house12 } : null;
// För få villaaffärer på tre månader men siffror för tolv: visa bara tolv månader, med en förklaring
// i stället för en kolumn full av "för få affärer".
const houseOnlyYear =
  area.houseScope === "area" &&
  house3?.pricePerSqm == null &&
  house3?.missing?.pricePerSqm === "F" &&
  house12?.pricePerSqm != null;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dataset",
      name: `Bostadspriser ${where}`,
      description: `Snittpris per kvadratmeter, medelpris, antal sålda bostäder och prisförändring för bostadsrätter${area.houseScope === "area" ? " och villor" : ""} ${where}, enligt Svensk Mäklarstatistik.`,
      url: new URL(areaUrl(area.slug), Astro.site).href,
      inLanguage: "sv",
      dateModified: dataset.updated,
      temporalCoverage: dataset.periods.m12,
      isBasedOn: dataset.source.url,
      creator: { "@type": "Organization", name: "Stockholms prislandskap" },
      spatialCoverage: {
        "@type": "Place",
        name: `${area.name}, Stockholms län`,
        geo: {
          "@type": "GeoShape",
          box: `${area.bbox[1]} ${area.bbox[0]} ${area.bbox[3]} ${area.bbox[2]}`,
        },
      },
      variableMeasured: [
        "Pris per kvadratmeter (kr)",
        "Medelpris (kr)",
        "Antal sålda bostäder",
        "Prisförändring (%)",
      ],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Områden",
          item: new URL(areasUrl(), Astro.site).href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: area.name,
          item: new URL(areaUrl(area.slug), Astro.site).href,
        },
      ],
    },
  ],
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<Base title={title} description={description} image={`og/${area.slug}.png`} imageAlt={imageAlt}>
  <script slot="head" is:inline type="application/ld+json" set:html={jsonLdText} />
  <div class="wrap area">
    <Breadcrumb items={[{ label: "Områden", href: areasUrl() }, { label: area.name }]} />

    <header class="hero">
      <div class="hero-text">
        <p class="kicker">
          {KIND_LABEL[area.kind]} · uppdaterad {updated}
        </p>
        <h1>Bostadspriser {where}</h1>

        <div class="figure">
          <p class="figure-label">Bostadsrätter, senaste 3 månaderna</p>
          {price != null ? (
            <p class:list={["figure-value", { "thin-value": thin }]}>
              {number(price)}
              <span class="figure-unit">kr/kvm</span>
            </p>
          ) : (
            <p class="figure-value figure-missing">
              Saknas <span class="figure-unit">({missingNote(ap3?.missing?.pricePerSqm)})</span>
            </p>
          )}
          {relSentence != null && (
            <p class="figure-context">
              {relSentence} länets snitt på {sqm(county.pricePerSqm)}
              {rankText && `, ${rankText}`}.
            </p>
          )}
          {trend && <p class="figure-trend">{trend}</p>}
        </div>

        {thin && ap3 && (
          <p class="thin-note" role="note">
            <strong>Få affärer:</strong>{" "}
            {ap3.sales != null
              ? `Bara ${number(ap3.sales)} bostadsrätter såldes ${where} de senaste 3 månaderna.`
              : "Antalet sålda bostadsrätter saknas."}{" "}
            Med så litet underlag kan snittpriset svänga mycket från månad till månad. Titta gärna
            på siffrorna för 12 månader längre ner.
          </p>
        )}

        <div class="actions hero-actions">
          <a class="btn btn-primary" href={mapUrl({ omrade: area.slug })}>
            Visa på kartan
          </a>
          {neighboursForCompare.length > 0 && (
            <a class="btn" href={compareUrl([area.slug, ...neighboursForCompare])}>
              Jämför med grannarna
            </a>
          )}
          <CopyLink />
          <a class="tertiary" href={mapUrl({ vy: "budget", omrade: area.slug })}>
            Har jag råd här?
          </a>
        </div>
      </div>

      <div class="hero-map">
        <Minimap area={area} />
      </div>
    </header>

    {hasContext && (
      <section class="page-section narrow" aria-labelledby="invanare">
        <div class="section-head">
          <h2 id="invanare">Vilka bor {where}?</h2>
          <p>Punkten är {area.name}, strecket snittet för hela Stockholms län.</p>
        </div>
        <AreaContext area={area} />
      </section>
    )}

    {price != null && (
      <section class="page-section" aria-labelledby="budget">
        <div class="section-head">
          <h2 id="budget">Vad räcker pengarna till {where}?</h2>
        </div>
        <BudgetFit slug={area.slug} name={area.name} pricePerSqm={price} />
      </section>
    )}

    {area.apartment && (
      <section class="page-section narrow" aria-labelledby="perioder">
        <div class="section-head">
          <h2 id="perioder">Senaste 3 och 12 månaderna</h2>
          <p>
            Tre månader visar läget just nu. Tolv månader bygger på fler affärer och svänger mindre.
          </p>
        </div>
        <StatsTable
          stats={area.apartment}
          caption={`Bostadsrätter ${where}, senaste 3 och 12 månaderna`}
          noun="bostadsrätter"
          turnover={turnover}
        />
        {turnover.m12 != null && (
          <p class="table-note">
            Andelen sålda räknas mot antalet bostadsrätter enligt SCB.
            {countyTurnover12 != null &&
              ` I hela länet såldes ${shareOneDecimal(countyTurnover12)} på 12 månader.`}
            {isDistrict &&
              " Mäklarstatistik och SCB drar stadsdelsområdenas gränser lite olika, så andelen är ungefärlig."}
          </p>
        )}
      </section>
    )}

    {area.houseScope !== "city" && (
      <section class="page-section narrow" aria-labelledby="villor">
        <div class="section-head">
          <h2 id="villor">Villor {where}</h2>
          {houseOnlyYear && house12 ? (
            <>
              <p>
                En villa {where} kostade i snitt {sqm(house12.pricePerSqm)} de senaste 12 månaderna,{" "}
                {relative(countyRatio(house12.pricePerSqm, "house", "m12"))} länets snitt för
                villor.
              </p>
              <p class="house-note" role="note">
                För få villaaffärer de senaste 3 månaderna
                {house3?.sales != null && ` (${number(house3.sales)} sålda)`} för ett pålitligt
                snitt. Se siffrorna för 12 månader i tabellen.
              </p>
            </>
          ) : area.houseScope === "area" && area.house ? (
            <p>
              {house3?.pricePerSqm != null
                ? `En villa ${where} kostade i snitt ${sqm(house3.pricePerSqm)} de senaste 3 månaderna, ${relative(countyRatio(house3.pricePerSqm, "house"))} länets snitt för villor.`
                : `Snittpriset för villor ${where} saknas för de senaste 3 månaderna.`}
            </p>
          ) : (
            <p>Det finns ingen villastatistik för {area.name}.</p>
          )}
        </div>
        {area.houseScope === "area" && houseStats && (
          <StatsTable
            stats={houseStats}
            periods={houseOnlyYear ? ["m12"] : undefined}
            caption={
              houseOnlyYear
                ? `Villor ${where}, senaste 12 månaderna`
                : `Villor ${where}, senaste 3 och 12 månaderna`
            }
            noun="villor"
          />
        )}
      </section>
    )}

    {rank && (
      <section class="page-section" aria-labelledby="plats">
        <div class="section-head">
          <h2 id="plats">Plats i länet</h2>
          <p>
            {area.name} är {rankText} i Stockholms län, räknat på pris per kvm för bostadsrätter de
            senaste 3 månaderna.
          </p>
        </div>
        <RankChart area={area} />
      </section>
    )}

    {similar.length > 0 && (
      <section class="page-section" aria-labelledby="grannar">
        <div class="section-head">
          <h2 id="grannar">Liknande grannområden</h2>
          <p>Områden nära {area.name} med snittpris i samma nivå.</p>
        </div>
        <SimilarAreas area={area} similar={similar} />
        <p class="more">
          <a href={compareUrl([area.slug, ...neighboursForCompare])}>
            Jämför {area.name} med {joinNames(similar.slice(0, 2).map((a) => a.name))}
          </a>
        </p>
      </section>
    )}

    <section class="page-section narrow source" aria-labelledby="om-siffrorna">
      <h2 id="om-siffrorna">Om siffrorna</h2>
      <p>
        Siffrorna kommer från{" "}
        <a href={dataset.source.url} rel="noopener">
          {dataset.source.name}
        </a>{" "}
        och gäller {dataset.periods.m3} (3 månader) och {dataset.periods.m12} (12 månader). De
        bygger på bostäder som sålts via mäklare. Pris per kvm är ett snitt för alla sålda bostäder
        i området, så en enskild bostad kan kosta mer eller mindre beroende på läge, skick och
        storlek.
      </p>
      {area.houseScope === "city" && house3?.pricePerSqm != null && (
        <p>
          Villor redovisas bara för hela Stockholms stad: {sqm(house3.pricePerSqm)} de senaste 3
          månaderna, med {number(house3.sales)} sålda villor. Svensk Mäklarstatistik delar inte upp
          villapriserna på stadsdelsområden.
        </p>
      )}
      {reasons.size > 0 && (
        <p>
          Några värden saknas.{" "}
          {reasons.has("F") && "Mäklarstatistik visar inte värden som bygger på för få affärer. "}
          {reasons.has("N") && "Värden som inte är representativa visas inte heller. "}
          {reasons.has("0") && "Där inga affärer gjorts finns inget värde. "}
          <a href={aboutUrl("#saknade-varden")}>Läs mer om saknade värden</a>
        </p>
      )}
      <p>
        {isDistrict
          ? `${area.name} är ett av Mäklarstatistiks tolv stadsdelsområden i Stockholms stad. Snittet gäller hela området, inte enskilda kvarter.`
          : `Siffrorna gäller hela ${area.name} kommun, inte enskilda orter eller kvarter.`}{" "}
        <a href={aboutUrl()}>Om datan och metoden</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .area {
    padding-top: var(--sp-4);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--sp-7);
    align-items: start;
    margin-top: var(--sp-5);
  }
  .hero-text {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
    padding-top: var(--sp-2);
  }
  .hero h1 {
    font-size: var(--fs-2xl);
    font-weight: 700;
    margin-top: calc(-1 * var(--sp-3));
    hyphens: auto;
  }
  .figure {
    display: grid;
    gap: var(--sp-1);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--c-line);
  }
  .figure-label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink-2);
  }
  .figure-value {
    font-size: var(--fs-num);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .figure-unit {
    font-size: var(--fs-lg);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--c-ink-2);
    margin-left: 0.15em;
  }
  .figure-missing {
    color: var(--c-ink-3);
  }
  .figure-context {
    font-size: var(--fs-lg);
    color: var(--c-ink-2);
    line-height: 1.4;
    max-width: 36ch;
    margin-top: var(--sp-1);
  }
  .figure-trend {
    font-size: var(--fs-md);
    color: var(--c-ink);
    line-height: 1.45;
    max-width: 44ch;
    margin-top: var(--sp-2);
  }
  .thin-note {
    background: var(--c-sunken);
    border-radius: var(--radius-sm);
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--c-ink);
    max-width: 52ch;
  }
  .thin-note strong {
    color: var(--c-ink);
  }
  .hero-actions {
    margin-top: var(--sp-1);
  }
  /*
   * Bred skärm: knapparna och "Har jag råd här?" på en rad. Kartan får en fast bredd
   * (minst 477 px, annars döljs grannetiketterna, se Minimap.astro) och texten resten.
   */
  @media (min-width: 1080px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 480px;
      gap: var(--sp-5);
    }
    .hero-actions {
      column-gap: var(--sp-3);
    }
    .hero-actions :global(.btn) {
      padding-inline: 14px;
    }
  }
  .table-note {
    margin-top: var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--c-ink-3);
  }
  .house-note {
    background: var(--c-sunken);
    border-radius: var(--radius-sm);
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--c-ink);
  }
  .tertiary {
    font-size: var(--fs-sm);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--sp-1);
  }
  /* Nyckeltalen: en platt rad med fyra tal och tunna avdelare, 2 × 2 på mobil. */
  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding-block: var(--sp-5);
    border-block: 1px solid var(--c-line);
  }
  .stat-row > :global(.stat) {
    padding-inline: var(--sp-5);
  }
  .stat-row > :global(.stat:first-child) {
    padding-left: 0;
  }
  .stat-row > :global(.stat + .stat) {
    border-left: 1px solid var(--c-line);
  }
  .narrow {
    max-width: 760px;
  }
  .more {
    margin-top: var(--sp-4);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .source {
    display: grid;
    gap: var(--sp-3);
    color: var(--c-ink-2);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--c-line);
  }
  .source h2 {
    font-size: var(--fs-lg);
    color: var(--c-ink);
  }
  .source p {
    max-width: 68ch;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
    .hero-map {
      max-width: 560px;
    }
    .stat-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-block: 0;
    }
    .stat-row > :global(.stat) {
      padding: var(--sp-4) var(--sp-4) var(--sp-4) var(--sp-5);
    }
    .stat-row > :global(.stat:nth-child(odd)) {
      padding-left: 0;
      border-left: 0;
    }
    .stat-row > :global(.stat:nth-child(n + 3)) {
      border-top: 1px solid var(--c-line);
    }
  }
  @media (max-width: 640px) {
    .hero {
      margin-top: var(--sp-3);
    }
    .hero-text {
      gap: var(--sp-4);
    }
    .hero h1 {
      margin-top: calc(-1 * var(--sp-2));
    }
    .figure {
      padding-top: var(--sp-4);
    }
    .figure-context {
      font-size: var(--fs-md);
    }
    .stat-row > :global(.stat) {
      padding-right: var(--sp-3);
      padding-left: var(--sp-4);
    }
    .hero-actions .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
</style>
