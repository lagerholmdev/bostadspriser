---
/**
 * Områdessida: en statisk sida per område. Det är hit folk kommer när de söker
 * "bostadspriser <område>", så allt viktigt ska stå i klartext högst upp.
 */
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import Breadcrumb from "../../../components/common/Breadcrumb.astro";
import ChangeValue from "../../../components/common/ChangeValue.astro";
import StatCard from "../../../components/common/StatCard.astro";
import Minimap from "../../../components/area/Minimap.astro";
import StatsTable from "../../../components/area/StatsTable.astro";
import RankChart from "../../../components/area/RankChart.astro";
import BudgetFit from "../../../components/area/BudgetFit.astro";
import SimilarAreas from "../../../components/area/SimilarAreas.astro";
import { aboutUrl, areasUrl, areaUrl, compareUrl, mapUrl } from "../../../components/common/links";
import "../../../components/common/common.css";
import {
  areas,
  countyRatio,
  countyStat,
  dataset,
  isThin,
  KIND_LABEL,
  priceRank,
  similarNeighbours,
} from "../../../lib/data";
import { change, date, inArea, money, number, ordinal, relative, sqm, MISSING_TEXT } from "../../../lib/format";
import type { Area, MissingReason, Stat } from "../../../lib/types";

export const getStaticPaths = (() => areas.map((area) => ({ params: { slug: area.slug }, props: { area } }))) satisfies GetStaticPaths;

interface Props {
  area: Area;
}
const { area } = Astro.props;

const where = inArea(area.slug, area.name); // "på Södermalm"
const ap3: Stat | null = area.apartment?.m3 ?? null;
const ap12: Stat | null = area.apartment?.m12 ?? null;
const price = ap3?.pricePerSqm ?? null;
const county = countyStat("apartment", "m3");
const ratio = countyRatio(price);
const thin = isThin(ap3, "m3");
const rank = priceRank(area);
const similar = similarNeighbours(area, 3);
const isDistrict = area.kind === "district";
const updated = date(dataset.updated);

const reasons = new Set<MissingReason>();
for (const s of [ap3, ap12, area.house?.m3, area.house?.m12]) {
  for (const r of Object.values(s?.missing ?? {})) if (r) reasons.add(r);
}
const missingNote = (r: MissingReason | undefined) => (r ? MISSING_TEXT[r] : "saknas");

const relSentence =
  ratio == null ? null : relative(ratio) === "i nivå med" ? "i nivå med" : `${relative(ratio)}`;

// Titel och beskrivning med riktiga siffror, för sökresultatet.
const title = `Bostadspriser ${where} – ${price != null ? sqm(price) : "pris per kvm"} | Stockholms prislandskap`;
const description =
  price != null && ap3
    ? `Bostadsrätter ${where} kostar i snitt ${sqm(price)} (${dataset.periods.m3}), ${relSentence} länets snitt. ` +
      `${number(ap3.sales)} sålda, ${change(ap3.change)} på tre månader. Grannområden, karta och vad 5 mkr räcker till.`
    : `Bostadspriser ${where}: pris per kvm, sålda bostäder och prisförändring från Svensk Mäklarstatistik.`;

const neighboursForCompare = similar.slice(0, 2).map((a) => a.slug);
const house3 = area.house?.m3 ?? null;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dataset",
      name: `Bostadspriser ${where}`,
      description: `Snittpris per kvadratmeter, medelpris, antal sålda bostäder och prisförändring för bostadsrätter${area.houseScope === "area" ? " och villor" : ""} ${where}, enligt Svensk Mäklarstatistik.`,
      url: new URL(areaUrl(area.slug), Astro.site).href,
      inLanguage: "sv",
      dateModified: dataset.updated,
      temporalCoverage: dataset.periods.m12,
      isBasedOn: dataset.source.url,
      creator: { "@type": "Organization", name: "Stockholms prislandskap" },
      spatialCoverage: {
        "@type": "Place",
        name: `${area.name}, Stockholms län`,
        geo: {
          "@type": "GeoShape",
          box: `${area.bbox[1]} ${area.bbox[0]} ${area.bbox[3]} ${area.bbox[2]}`,
        },
      },
      variableMeasured: ["Pris per kvadratmeter (kr)", "Medelpris (kr)", "Antal sålda bostäder", "Prisförändring (%)"],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Områden", item: new URL(areasUrl(), Astro.site).href },
        { "@type": "ListItem", position: 2, name: area.name, item: new URL(areaUrl(area.slug), Astro.site).href },
      ],
    },
  ],
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<Base title={title} description={description} image={`og/${area.slug}.png`}>
  <script slot="head" is:inline type="application/ld+json" set:html={jsonLdText} />

  <div class="wrap area">
    <Breadcrumb items={[{ label: "Områden", href: areasUrl() }, { label: area.name }]} />

    <header class="hero">
      <div class="hero-text">
        <p class="eyebrow">{KIND_LABEL[area.kind]} · Uppdaterad {updated}</p>
        <h1>Bostadspriser {where}</h1>

        <div class="figure">
          <p class="figure-label">Bostadsrätter, senaste 3 månaderna</p>
          {
            price != null ? (
              <p class:list={["figure-value", { "thin-value": thin }]}>
                {number(price)}
                <span class="figure-unit">kr/kvm</span>
              </p>
            ) : (
              <p class="figure-value figure-missing">
                Saknas <span class="figure-unit">({missingNote(ap3?.missing?.pricePerSqm)})</span>
              </p>
            )
          }
          {
            ratio != null && (
              <p class="figure-context">
                {relSentence} länets snitt på {sqm(county.pricePerSqm)}
                {rank && (
                  <>
                    {" "}
                    och det {ordinal(rank.rank)} dyraste av {rank.total} områden
                  </>
                )}
                .
              </p>
            )
          }
        </div>

        {
          thin && ap3 && (
            <p class="thin-note" role="note">
              <strong>Få affärer.</strong>{" "}
              {ap3.sales != null
                ? `Bara ${number(ap3.sales)} bostadsrätter såldes ${where} de senaste 3 månaderna.`
                : "Antalet sålda bostadsrätter saknas."}{" "}
              Med så litet underlag kan snittpriset svänga mycket från månad till månad. Titta gärna på
              siffrorna för 12 månader längre ner.
            </p>
          )
        }

        <div class="actions hero-actions">
          <a class="btn btn-primary" href={mapUrl({ omrade: area.slug })}>Visa på kartan</a>
          {
            neighboursForCompare.length > 0 && (
              <a class="btn" href={compareUrl([area.slug, ...neighboursForCompare])}>
                Jämför med grannarna
              </a>
            )
          }
          <a class="tertiary" href={mapUrl({ vy: "budget", omrade: area.slug })}>Har jag råd här?</a>
        </div>
      </div>

      <div class="hero-map">
        <Minimap area={area} />
      </div>
    </header>

    {
      ap3 && (
        <section class="page-section" aria-labelledby="nyckeltal">
          <h2 id="nyckeltal" class="visually-hidden">
            Nyckeltal för bostadsrätter
          </h2>
          <dl class="stats">
            <StatCard label="Medelpris" note="per såld bostadsrätt, 3 mån" muted={thin}>
              {ap3.meanPrice != null ? money(ap3.meanPrice) : <span class="chg-none">{missingNote(ap3.missing?.meanPrice)}</span>}
            </StatCard>
            <StatCard
              label="Sålda bostäder"
              note={ap12?.sales != null ? `senaste 3 mån, ${number(ap12.sales)} på 12 mån` : "senaste 3 mån"}
            >
              {ap3.sales != null ? number(ap3.sales) : <span class="chg-none">{missingNote(ap3.missing?.sales)}</span>}
            </StatCard>
            <StatCard label="Förändring 3 mån" note="mot de tre månaderna före">
              <ChangeValue value={ap3.change} missing={ap3.missing?.change} word />
            </StatCard>
            <StatCard label="Förändring 12 mån" note="mot samma månader året innan">
              <ChangeValue value={ap12?.change} missing={ap12?.missing?.change} word />
            </StatCard>
          </dl>
        </section>
      )
    }

    {
      price != null && (
        <section class="page-section" aria-labelledby="budget">
          <div class="section-head">
            <h2 id="budget">Vad räcker pengarna till {where}?</h2>
          </div>
          <BudgetFit slug={area.slug} name={area.name} pricePerSqm={price} />
        </section>
      )
    }

    {
      area.apartment && (
        <section class="page-section narrow" aria-labelledby="perioder">
          <div class="section-head">
            <h2 id="perioder">Senaste 3 och 12 månaderna</h2>
            <p>
              Tre månader visar läget just nu. Tolv månader bygger på fler affärer och svänger mindre.
            </p>
          </div>
          <StatsTable
            stats={area.apartment}
            caption={`Bostadsrätter ${where}, senaste 3 och 12 månaderna`}
            noun="bostadsrätter"
          />
        </section>
      )
    }

    <section class="page-section narrow" aria-labelledby="villor">
      <div class="section-head">
        <h2 id="villor">Villor {where}</h2>
        {
          area.houseScope === "city" && house3 ? (
            <p>
              Villor redovisas för hela Stockholms stad: {sqm(house3.pricePerSqm)} de senaste 3 månaderna, med{" "}
              {number(house3.sales)} sålda villor och ett medelpris på {money(house3.meanPrice)}. Svensk
              Mäklarstatistik delar inte upp villapriserna på stadsdelsområden, så siffran gäller hela staden och inte
              bara {area.name}.
            </p>
          ) : area.houseScope === "area" && area.house ? (
            <p>
              {house3?.pricePerSqm != null
                ? `En villa ${where} kostade i snitt ${sqm(house3.pricePerSqm)} de senaste 3 månaderna, ${relative(countyRatio(house3.pricePerSqm, "house"))} länets snitt för villor.`
                : `Snittpriset för villor ${where} saknas för de senaste 3 månaderna.`}
            </p>
          ) : (
            <p>Det finns ingen villastatistik för {area.name}.</p>
          )
        }
      </div>
      {
        area.houseScope === "area" && area.house && (
          <StatsTable stats={area.house} caption={`Villor ${where}, senaste 3 och 12 månaderna`} noun="villor" />
        )
      }
    </section>

    {
      rank && (
        <section class="page-section" aria-labelledby="plats">
          <div class="section-head">
            <h2 id="plats">Plats i länet</h2>
            <p>
              {area.name} är det {ordinal(rank.rank)} dyraste av de {rank.total} områdena i Stockholms län, räknat på pris
              per kvm för bostadsrätter de senaste 3 månaderna.
            </p>
          </div>
          <RankChart area={area} />
        </section>
      )
    }

    {
      similar.length > 0 && (
        <section class="page-section" aria-labelledby="grannar">
          <div class="section-head">
            <h2 id="grannar">Liknande grannområden</h2>
            <p>Områden nära {area.name} med snittpris i samma nivå.</p>
          </div>
          <SimilarAreas area={area} similar={similar} />
          <p class="more">
            <a href={compareUrl([area.slug, ...neighboursForCompare])}>Jämför {area.name} med {similar
                .slice(0, 2)
                .map((a) => a.name)
                .join(" och ")}</a>
          </p>
        </section>
      )
    }

    <section class="page-section narrow source" aria-labelledby="om-siffrorna">
      <h2 id="om-siffrorna">Om siffrorna</h2>
      <p>
        Siffrorna kommer från <a href={dataset.source.url} rel="noopener">{dataset.source.name}</a> och gäller{" "}
        {dataset.periods.m3} (3 månader) och {dataset.periods.m12} (12 månader). De bygger på bostäder som sålts via
        mäklare. Pris per kvm är ett snitt för alla sålda bostäder i området, så en enskild bostad kan kosta mer eller
        mindre beroende på läge, skick och storlek.
      </p>
      {
        reasons.size > 0 && (
          <p>
            Några värden saknas.{" "}
            {reasons.has("F") && "Mäklarstatistik visar inte värden som bygger på för få affärer. "}
            {reasons.has("N") && "Värden som inte är representativa visas inte heller. "}
            {reasons.has("0") && "Där inga affärer gjorts finns inget värde. "}
            <a href={aboutUrl("#saknade-varden")}>Läs mer om saknade värden</a>
          </p>
        )
      }
      <p>
        {
          isDistrict
            ? `${area.name} är ett av Mäklarstatistiks tolv stadsdelsområden i Stockholms stad. Snittet gäller hela området, inte enskilda kvarter.`
            : `Siffrorna gäller hela ${area.name} kommun, inte enskilda orter eller kvarter.`
        }{" "}
        <a href={aboutUrl()}>Om datan och metoden</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .area {
    padding-top: var(--sp-4);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--sp-7);
    align-items: start;
    margin-top: var(--sp-5);
  }
  .hero-text {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
    padding-top: var(--sp-2);
  }
  .hero h1 {
    font-size: var(--fs-2xl);
    font-weight: 700;
    margin-top: calc(-1 * var(--sp-3));
  }
  .figure {
    display: grid;
    gap: var(--sp-1);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--c-line);
  }
  .figure-label {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink-2);
  }
  .figure-value {
    font-size: var(--fs-num);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .figure-unit {
    font-size: var(--fs-lg);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--c-ink-2);
    margin-left: 0.15em;
  }
  .figure-missing {
    color: var(--c-ink-3);
  }
  .figure-context {
    font-size: var(--fs-lg);
    color: var(--c-ink-2);
    line-height: 1.4;
    max-width: 34ch;
    margin-top: var(--sp-1);
  }
  .thin-note {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-left: 4px solid var(--c-near);
    border-radius: var(--radius-sm);
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    max-width: 52ch;
  }
  .thin-note strong {
    color: var(--c-ink);
  }
  .hero-actions {
    margin-top: var(--sp-1);
  }
  .tertiary {
    font-size: var(--fs-sm);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding-inline: var(--sp-1);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-4);
    margin: 0;
  }
  .narrow {
    max-width: 760px;
  }
  .more {
    margin-top: var(--sp-4);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .source {
    display: grid;
    gap: var(--sp-3);
    color: var(--c-ink-2);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--c-line);
  }
  .source h2 {
    font-size: var(--fs-lg);
    color: var(--c-ink);
  }
  .source p {
    max-width: 68ch;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
    .hero-map {
      max-width: 560px;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .hero {
      margin-top: var(--sp-3);
    }
    .hero-text {
      gap: var(--sp-4);
    }
    .hero h1 {
      margin-top: calc(-1 * var(--sp-2));
    }
    .figure {
      padding-top: var(--sp-4);
    }
    .figure-context {
      font-size: var(--fs-md);
    }
    .stats {
      gap: var(--sp-3);
    }
    .hero-actions .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
    .tertiary {
      min-height: 44px;
    }
  }
</style>
