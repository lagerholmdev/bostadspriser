---
/** Alla områden, i två grupper sorterade på pris. Sök och sortering läggs på med JavaScript. */
import Base from "../../layouts/Base.astro";
import AreaRow from "../../components/common/AreaRow.astro";
import PriceLegend from "../../components/common/PriceLegend.astro";
import { compareUrl, mapUrl } from "../../lib/links";
import "../../components/common/common.css";
import { areas, countyStat, dataset, stat } from "../../lib/data";
import { sqm } from "../../lib/format";
import type { Area } from "../../lib/types";

const price = (a: Area) => stat(a, "apartment", "m3")?.pricePerSqm ?? -1;
const byPrice = (list: Area[]) => [...list].sort((a, b) => price(b) - price(a));
const max = Math.max(...areas.map(price));
const groups = [
  {
    id: "stad",
    title: "Stockholms stad",
    note: "Mäklarstatistik delar in staden i 12 stadsdelsområden.",
    list: byPrice(areas.filter((a) => a.kind === "district")),
  },
  {
    id: "kommuner",
    title: "Kommuner i länet",
    note: "De övriga 25 kommunerna i Stockholms län, var och en som en helhet.",
    list: byPrice(areas.filter((a) => a.kind === "municipality")),
  },
];
const county = countyStat("apartment", "m3");
const ranked = byPrice(areas).filter((a) => price(a) > 0);
const cheapest = ranked[ranked.length - 1];
const dearest = ranked[0];

const title = "Bostadspriser i Stockholms län, område för område | Stockholms prislandskap";
const description =
  `Pris per kvm för bostadsrätter i alla ${areas.length} områden i Stockholms län, ${dataset.periods.m3}.` +
  (cheapest && dearest
    ? ` Från ${sqm(price(cheapest))} i ${cheapest.name} till ${sqm(price(dearest))} i ${dearest.name}.`
    : "");
---

<Base title={title} description={description} image="og/start.png">
  <div class="wrap list-page">
    <header class="intro">
      <h1>Bostadspriser i Stockholms län, område för område</h1>
      <p class="lead">
        Snittpris per kvm för bostadsrätter i {areas.length} områden, sålda {dataset.periods.m3}.
        Länets snitt är {sqm(county.pricePerSqm)}. Välj ett område för att se fler siffror,
        grannområden och vad din budget räcker till.
      </p>
      <p class="intro-links">
        <a class="btn" href={compareUrl()}>
          Jämför områden
        </a>
        <a class="btn" href={mapUrl()}>
          Visa på kartan
        </a>
      </p>
    </header>

    <div class="toolbar" data-list-tools hidden>
      <div class="search">
        <label for="area-search">Sök område, stadsdel eller ort</label>
        <input
          id="area-search"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="Till exempel Aspudden eller Nacka"
          aria-describedby="search-status"
        />
      </div>
      <fieldset class="sort">
        <legend>Sortera</legend>
        <div class="seg">
          <label>
            <input type="radio" name="sort" value="pris" checked /> <span>Pris</span>
          </label>
          <label>
            <input type="radio" name="sort" value="namn" /> <span>Namn</span>
          </label>
        </div>
      </fieldset>
    </div>
    <p id="search-status" class="status" aria-live="polite"></p>

    {groups.map((g) => (
      <section class="group" aria-labelledby={`g-${g.id}`} data-group>
        <div class="group-head">
          <h2 id={`g-${g.id}`}>{g.title}</h2>
          <p>{g.note}</p>
        </div>
        <div class="table-box">
          <table class="data-table area-table">
            <caption class="visually-hidden">
              {g.title}: pris per kvm för bostadsrätter de senaste 3 månaderna,{" "}
              <span data-sort-caption>dyrast först</span>
            </caption>
            <thead>
              <tr>
                <th scope="col">Område</th>
                <th scope="col" class="col-price">
                  Pris per kvm, 3 mån
                </th>
                <th scope="col" class="col-chg">
                  Förändring, 1 år
                </th>
                <th scope="col" class="col-sales">
                  Sålda, 3 mån
                </th>
              </tr>
            </thead>
            <tbody>
              {g.list.map((a) => (
                <AreaRow area={a} max={max} />
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <div class="after">
      <PriceLegend title="Färgerna i staplarna: pris per kvm, tusen kr" />
      <p class="fineprint">
        Förändring är prisutvecklingen på ett år: de senaste tre månaderna jämfört med samma månader
        året innan. Områden med få affärer är märkta, eftersom snittet där kan svänga mycket. Källa:{" "}
        <a href={dataset.source.url} rel="noopener">
          {dataset.source.name}
        </a>
        .
      </p>
    </div>
  </div>
</Base>

<script>
  import "../../scripts/area-list";
</script>

<style>
  .list-page {
    padding-top: var(--sp-7);
  }
  .intro {
    display: grid;
    gap: var(--sp-3);
    max-width: 68ch;
  }
  .intro h1 {
    font-size: var(--fs-2xl);
    font-weight: 700;
  }
  .lead {
    font-size: var(--fs-lg);
    color: var(--c-ink-2);
    line-height: 1.45;
  }
  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    margin-top: var(--sp-2);
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--sp-4) var(--sp-6);
    margin-top: var(--sp-6);
    max-width: 880px;
  }
  .toolbar[hidden] {
    display: none;
  }
  .search {
    display: grid;
    gap: var(--sp-1);
    flex: 1 1 260px;
    max-width: 420px;
  }
  .search label,
  .sort legend {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink-2);
  }
  .search input {
    font: inherit;
    min-height: 44px;
    padding: 0 var(--sp-3);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius);
    background: var(--c-surface);
    color: var(--c-ink);
    width: 100%;
  }
  .search input::placeholder {
    color: var(--c-ink-3);
  }
  .search input:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 0;
    border-color: var(--c-accent);
  }
  .sort {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-1);
  }
  .sort legend {
    padding: 0;
    margin-bottom: var(--sp-1);
  }
  /* Segmenterat val, samma som på kartsidan: vit tumme på nedsänkt spår. */
  .seg {
    display: inline-flex;
    background: var(--c-sunken);
    border-radius: var(--radius);
    padding: 3px;
    gap: 3px;
  }
  .seg label {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    display: inline-flex;
    align-items: center;
    min-height: calc(var(--tap) - 6px);
    padding: 0 var(--sp-4);
    border-radius: 7px;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink-2);
    pointer-events: none;
  }
  .seg label:hover span {
    color: var(--c-ink);
  }
  .seg input:checked + span {
    background: var(--c-surface);
    color: var(--c-accent);
    box-shadow: 0 0 0 2px var(--c-accent);
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
  }
  .status {
    min-height: 1.5em;
    margin-top: var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    max-width: 68ch;
  }
  .status :global(a) {
    font-weight: 600;
  }
  .group {
    margin-top: var(--sp-6);
    max-width: 880px;
  }
  .group[hidden] {
    display: none;
  }
  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-4);
    margin-bottom: var(--sp-4);
  }
  .group-head h2 {
    font-size: var(--fs-xl);
    font-weight: 600;
  }
  .group-head p {
    color: var(--c-ink-3);
    font-size: var(--fs-sm);
  }

  /* Rader: hela raden är klickbar via länkens ::after. */
  .area-table :global(.area-row) {
    position: relative;
  }
  .area-table :global(.area-row:hover) {
    background: var(--c-page);
  }
  .area-table :global(.row-name) {
    font-weight: 600;
    text-decoration: none;
    color: var(--c-ink);
    hyphens: auto;
  }
  .area-table :global(.area-row:hover .row-name) {
    color: var(--c-accent);
    text-decoration: underline;
  }
  .area-table :global(.row-name::after) {
    content: "";
    position: absolute;
    inset: 0;
  }
  .area-table :global(.row-name:focus-visible) {
    outline: none;
  }
  .area-table :global(.area-row:has(.row-name:focus-visible)) {
    outline: 2px solid var(--c-accent);
    outline-offset: -2px;
  }
  .area-table :global(.row-via) {
    display: block;
    font-size: var(--fs-sm);
    font-weight: 400;
    color: var(--c-ink-2);
  }
  .area-table :global(.row-via[hidden]) {
    display: none;
  }
  .area-table :global(.row-sub) {
    display: none;
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    font-weight: 400;
  }
  .area-table :global(.row-sub .thin-tag) {
    margin-left: var(--sp-2);
  }
  /* Fasta kolumner, så att de två tabellerna linjerar. */
  .area-table {
    table-layout: fixed;
  }
  .area-table :global(thead th:first-child) {
    width: 31%;
  }
  .area-table :global(.col-price) {
    width: 37%;
    text-align: left;
  }
  .area-table :global(.price) {
    display: block;
    font-weight: 600;
  }
  .area-table :global(td .price-bar) {
    margin-top: 6px;
  }
  .area-table :global(.col-sales .thin-tag) {
    margin-left: var(--sp-2);
  }
  /* Få affärer: texten behåller full kontrast, stapeln får kartans ränder. */
  .area-table :global(.is-thin .row-name),
  .area-table :global(.is-thin .price) {
    color: var(--c-ink-2);
  }
  .area-table :global(.is-thin .price-bar > span) {
    background-image: var(--hatch);
  }
  .area-table :global(thead th) {
    white-space: nowrap;
  }
  /* "på ett år" står bara på mobilen, där tabellhuvudet är dolt. */
  .area-table :global(.chg-unit) {
    display: none;
  }
  .after {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-6);
    max-width: 880px;
  }
  @media (max-width: 640px) {
    .list-page {
      padding-top: var(--sp-5);
    }
    .lead {
      font-size: var(--fs-md);
    }
    .group-head h2 {
      font-size: var(--fs-lg);
    }
  }
  @media (max-width: 559px) {
    /*
     * Mobil: raden staplas. Namn och pris på första raden, stapel och förändring
     * under, antal sålda minst. Ingen tabell som bryter namnen.
     */
    .area-table :global(thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .area-table,
    .area-table :global(tbody) {
      display: block;
    }
    .area-table :global(.area-row) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "name value"
        "via via"
        "bar chg"
        "sub sub";
      align-items: center;
      column-gap: var(--sp-4);
      min-height: 48px;
      padding: var(--sp-3) var(--sp-4);
      border-bottom: 1px solid var(--c-line);
    }
    .area-table :global(tbody .area-row:last-child) {
      border-bottom: 0;
    }
    .area-table :global(.area-row > th),
    .area-table :global(.area-row > td.col-price) {
      display: contents;
    }
    .area-table :global(.area-row > td.col-chg) {
      grid-area: chg;
      padding: 0;
      border: 0;
      font-size: var(--fs-sm);
      margin-top: 4px;
      white-space: nowrap;
    }
    .area-table :global(.chg-unit) {
      display: inline;
      margin-left: 0.3em;
      font-size: var(--fs-xs);
      color: var(--c-ink-3);
    }
    .area-table :global(.area-row > td.col-sales) {
      display: none;
    }
    .area-table :global(.row-name) {
      grid-area: name;
      line-height: 1.3;
      overflow-wrap: break-word;
      min-width: 0;
    }
    .area-table :global(.price) {
      grid-area: value;
      text-align: right;
      white-space: nowrap;
    }
    .area-table :global(.row-via) {
      grid-area: via;
    }
    .area-table :global(td .price-bar) {
      grid-area: bar;
      margin-top: 4px;
    }
    .area-table :global(.row-sub) {
      grid-area: sub;
      display: block;
      margin-top: 2px;
    }
  }
</style>
